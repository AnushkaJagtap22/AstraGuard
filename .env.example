# AstraGuard Environment Configuration Template
# Copy this file to .env and provide your API keys before running the application.

# AI Engine / LLM API Keys
MISTRAL_API_KEY=your_mistral_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Backend Server Configuration
HOST=127.0.0.1
PORT=8000
BACKEND_URL=http://127.0.0.1:8000

# Frontend & Browser Extension Configuration
VITE_API_URL=http://127.0.0.1:8000
ASTRAGUARD_APP_URL=http://localhost:5176
